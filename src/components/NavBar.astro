---
import { Image } from 'astro:assets';
import MvmntLogo from '../assets/images/MVMNT-logo-hotizontal2-dark.svg';
import MvmntLogo2 from '../assets/images/mvmnt-logo-horizontal2-color.svg';
import MvmntLogo3 from '../assets/images/mvmnt-logo-horizontal-color.svg';
import ThemeToggle from './ThemeToggle.astro';
import NavbarThemeWrapper from './ThemeSelector';
import {
  Activity,
  CircleHelp,
  House,
  MessageCircle,
  UserRound,
} from 'lucide-react';
---

<header class=`navbar w-full shadow-md transition-colors duration-30 bg-white`>
  <nav class="w-full flex justify-between items-center px-4 py-1">
    <div class="flex mt-8">
      <a href={`${import.meta.env.BASE_URL}`} class="flex items-center">
        <div>
          <MvmntLogo2 slot="logo1" class="w-52 h-16 md:w-80 lg:w-92 md:h-24" />
        </div>
      </a>
    </div>
    <div class="lg:flex items-center gap-6 hidden text-stone-950 text-lg">
      <a
        href={`${import.meta.env.BASE_URL}about`}
        class="link link-hover font-cabin tracking-wider">About</a
      >
      <a
        href={`${import.meta.env.BASE_URL}services`}
        class="link link-hover font-montserrat tracking-wider">Services</a
      >

      <a
        href={`${import.meta.env.BASE_URL}faq`}
        class="link link-hover font-montserrat tracking-wider">FAQ</a
      >

      <a
        href={`${import.meta.env.BASE_URL}contact`}
        class="btn bg-deeper-teal rounded-2xl shadow-2xl px-6 text-white font-semibold"
        >CONTACT US</a
      >
    </div>
    <div class="drawer drawer-end ml-auto flex justify-end lg:hidden">
      <input id="mobile-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content">
        <label
          for="mobile-drawer"
          class="btn btn-square btn-sm bg-white border-0 p-0 w-12 h-12 drop-shadow-sm"
          aria-label="Open menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 stroke-deeper-teal drop-shadow-sm"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </label>
      </div>

      <div class="drawer-side z-50">
        <label for="mobile-drawer" class="drawer-overlay"></label>

        <div
          class="flex min-h-full w-64 flex-col bg-sky-alt-bg
           px-6 py-8 text-stone-900"
        >
          <ul
            class="menu w-full gap-1 p-0 text-lg
                     [&>li:not(:last-child)]:border-b
         [&>li:not(:last-child)]:border-stone-900/10"
          >
            <li>
              <a href={`${import.meta.env.BASE_URL}`}>
                <House className="size-4 text-deeper-teal" strokeWidth={1.5} />
                <span>start here</span>
              </a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}about`}>
                <UserRound
                  className="size-4 text-deeper-teal"
                  strokeWidth={1.5}
                />
                <span>meet your PT</span>
              </a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}services`}>
                <Activity
                  className="size-4 text-deeper-teal"
                  strokeWidth={1.5}
                />
                <span>work with me</span>
              </a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}contact`}>
                <MessageCircle
                  className="size-4 text-deeper-teal"
                  strokeWidth={1.5}
                />
                <span>let's connect</span>
              </a>
            </li>
            <li>
              <a href={`${import.meta.env.BASE_URL}faq`}>
                <CircleHelp
                  className="size-4 text-deeper-teal"
                  strokeWidth={1.5}
                />
                <span>FAQs</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  @reference "tailwindcss";
  .menu a {
    @apply transition-all duration-150 ease-in-out flex w-full items-center px-3 py-2 rounded-md;
    @apply active:bg-sky-700 active:text-white active:scale-[0.98];
  }
</style>
