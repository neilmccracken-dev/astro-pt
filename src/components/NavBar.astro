---
import MvmntLogo2 from '../assets/images/mvmnt-logo-horizontal2-color.svg';
import {
  House,
  UserRound,
  HeartPulse,
  Mail,
  CircleHelp,
  Activity,
} from 'lucide-react';

const currentPath = Astro.url.pathname;
const contactHref = `${import.meta.env.BASE_URL}contact`;

const isContactActive =
  currentPath.replace(/\/$/, '') === contactHref.replace(/\/$/, '');
const menuItems = [
  {
    label: 'Start here',
    href: '',
    icon: House,
    desktop: true,
  },
  {
    label: 'Meet your PT',
    href: 'about',
    icon: UserRound,
    desktop: true,
  },
  {
    label: 'Work with me',
    href: 'services',
    icon: Activity,
    desktop: true,
  },
  {
    label: "Let's connect",
    href: 'contact',
    icon: Mail,
    desktop: false,
  },
  {
    label: 'FAQ',
    href: 'faq',
    icon: CircleHelp,
    desktop: true,
  },
];
---

<header class=`navbar w-full shadow-md transition-colors duration-30 bg-white`>
  <nav class="w-full flex justify-between items-center px-4 py-1">
    <div class="flex mt-8">
      <a href={`${import.meta.env.BASE_URL}`} class="flex items-center">
        <div>
          <MvmntLogo2 slot="logo1" class="w-52 h-16 md:w-80 lg:w-92 md:h-24" />
        </div>
      </a>
    </div>

    <div class="lg:flex items-center gap-6 hidden text-stone-950 text-lg">
      {
        menuItems
          .filter((item) => item.desktop)
          .map((item) => {
            const href = `${import.meta.env.BASE_URL}${item.href}`;
            const isActive =
              currentPath.replace(/\/$/, '') === href.replace(/\/$/, '');

            return (
              <a
                href={href}
                class:list={[
                  isActive &&
                    'underline text-deeper-teal decoration-2 underline-offset-4 decoration-sky-alt font-semibold ',
                  '  font-cabin tracking-wider transition-all duration-150 ease-in-out ',
                ]}
              >
                {item.label}
              </a>
            );
          })
      }

      <a
        href={contactHref}
        class:list={[
          'btn bg-deeper-teal rounded-2xl shadow-2xl px-6 text-white font-semibold',
          isContactActive &&
            'underline text-deeper-teal decoration-2 underline-offset-4 decoration-sky-alt font-semibold',
        ]}
        class="">CONTACT US</a
      >
    </div>
    <div class="drawer drawer-end ml-auto flex justify-end lg:hidden">
      <input id="mobile-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content">
        <label
          for="mobile-drawer"
          class="btn btn-square btn-sm bg-white border-0 p-0 w-12 h-12 drop-shadow-sm"
          aria-label="Open menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 stroke-deeper-teal drop-shadow-sm"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </label>
      </div>

      <div class="drawer-side z-50">
        <label for="mobile-drawer" class="drawer-overlay"></label>

        <div
          class="flex min-h-full w-64 flex-col bg-sky-alt-bg
           px-6 py-8 text-stone-900"
        >
          <ul
            class="menu w-full gap-1 p-0 text-lg
                     [&>li:not(:last-child)]:border-b
                   [&>li:not(:last-child)]:border-stone-900/10"
          >
            {
              menuItems.map((item) => {
                const Icon = item.icon;
                const href = `${import.meta.env.BASE_URL}${item.href}`;
                const isActive =
                  currentPath.replace(/\/$/, '') === href.replace(/\/$/, '');
                return (
                  <li>
                    <a
                      href={href}
                      class:list={[
                        isActive &&
                          'underline text-deeper-teal decoration-2 underline-offset-4 decoration-sky-alt font-semibold',
                        `flex w-full items-center rounded-md px-3 py-2 transition-all duration-150 ease-in-out
                            active:scale-[0.98] active:bg-sky-700 active:text-white`,
                      ]}
                    >
                      <Icon className="size-4 shrink-0" strokeWidth={1.5} />

                      <span>{item.label}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>
