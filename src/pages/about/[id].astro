---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { certifications } from '../../data/certifications';
import { Image } from 'astro:assets';
export async function getStaticPaths() {
  return certifications.map((certification) => ({
    params: {
      id: certification.slug,
    },
  }));
}

const { id } = Astro.params;

const certification = certifications.find((c) => c.slug === id);
if (!certification) {
  return Astro.redirect('/404');
}
---

<BaseLayout hasWave={true} title="About">
  <div
    class="flex flex-col lg:flex-row max-w-7xl overflow-hidden mx-auto m-8 shadow-2xl bg-base-200"
  >
    <div
      class="flex w-full items-center justify-center
               lg:w-3/12"
    >
      <Image
        src={certification.image}
        alt={certification.name}
        widths={[320, 480, 640, 960]}
        sizes="(max-width: 1023px) 100vw, 25vw"
        class="h-auto max-h-110 w-full object-contain"
      />
    </div>
    <div
      class="flex w-full flex-col items-center justify-center
               lg:bg-base-200 px-6 py-10
               sm:px-10
               lg:w-9/12 lg:p-12"
    >
      <h2 class="text-2xl">{certification.name}</h2>
      <p class="mt-4 leading-loose max-w-xl">{certification.description}</p>
    </div>
  </div>
</BaseLayout>
