---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import elieHeadshot from '@assets/images/headshot.jpg';
import SpecialtiesStock from '@assets/images/certifications/specialties.jpg';
import SectionHeading from '../../components/SectionHeading.astro';

interface Props {
  index?: number;
}
const { index = 1 } = Astro.props;
const backgroundImg =
  'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?q=80&w=1920&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&sat=-100';

const optimizedBackground = await getImage({
  src: backgroundImg,
  format: 'webp',
  inferSize: true,
  widths: [1024, 1440, 1920, 2560],
});

const certifications = [
  {
    short: 'OCS',
    slug: 'ocs',
    name: 'Orthopedic Clinical Specialist',
    angle: 0,
    radius: 290,
    image: SpecialtiesStock,
    description: `A prestigious board certification representing advanced expertise in orthopedic
     physical therapy and one of the highest levels of specialization a physical therapist can
      achieve. This training reflects a deep understanding of complex injuries, movement mechanics,
       and evidence-based treatment strategies to help patients recover and return to the activities
        they love`,
  },
  {
    short: 'TPS',
    slug: 'tps',
    name: 'Therapeutic Pain Specialist',
    angle: 60,
    radius: 330,
    image: SpecialtiesStock,
    description: `Advanced training focused on understanding persistent pain through a comprehensive 
    approach that combines modern pain science, movement, and individualized treatment strategies.`,
  },
  {
    short: 'CSCS',
    slug: 'cscs',
    name: 'Certified Strength and Conditioning Specialist',
    angle: 120,
    radius: 330,
    image: SpecialtiesStock,
    description: `A nationally recognized certification in strength and performance training, 
    allowing Dr. Elie to create evidence-based programs that help patients build resilience, 
    improve performance, and prevent future injuries.`,
  },
  {
    short: 'TPI 3',
    slug: 'tpi',
    name: 'Titleist Performance Institute Medical Level 3',
    angle: 180,
    radius: 290,
    image: SpecialtiesStock,
    description: `
    The highest level of TPI Medical certification, representing advanced expertise in golf-specific
     movement assessment, injury prevention, and performance optimization. This is focused on
      identifying how the body influences the golf swing, helping golfers improve movement
       efficiency, reduce injury risk, and return to the course with confidence.
    `,
  },
  {
    short: 'Barre',
    name: 'Pure Barre Instructor',
    slug: 'barre',
    angle: 240,
    radius: 330,
    image: SpecialtiesStock,
    description: `Specialized training in barre-based movement, emphasizing strength, mobility,
       posture, and body awareness to help patients improve control, endurance, and overall movement quality`,
  },
  {
    short: 'DN',
    name: 'Dry Needling Certification',
    slug: 'dn',
    angle: 300,
    radius: 330,
    image: SpecialtiesStock,
    description: `Advanced training in the use of dry needling as part of a comprehensive physical therapy
       approach to address muscle tension, trigger points, and movement limitations. 
       When clinically appropriate, Dr. Elie incorporates dry needling alongside hands-on therapy
        and targeted exercise to help reduce pain, improve mobility, and support optimal movement.`,
  },
];
---

<BaseLayout hasWave={true} title="About">
  <div class="grid grid-cols-6 w-full min-w-0">
    <div class="col-span-6 p-5 py-8 bg-base-200">
      <div
        class="flex flex-col-reverse md:flex-row items-center justify-center mb-32"
      >
        <!-- Text -->
        <div class="bio flex-1 max-w-4xl" style={`--i: ${index};`}>
          <div class="mb-4 flex flex-wrap items-baseline gap-1">
            <div
              class="flex-row md:flex items-baseline gap-2 border-l-3 border-light-blue pl-5 py-2.5"
            >
              <h2 class="text-3xl font-cabin tracking-tight">Elie Sabins</h2>
              <span class="md:ml-2 font-cabin font-thin tracking-widest italic">
                PT, DPT, OCS, CSCS, TPS
              </span>
            </div>
          </div>
          <p class="text-lg mb-1 font-extralight underline">Meet Dr. Elie,</p>
          <div class="flex flex-col gap-3 font-cabin text-gray-600 max-w-2xl">
            <p>
              Originally from Washington, Dr. Elie has always had a passion for
              helping people stay active and do the things they love. After
              earning her Doctorate of Physical Therapy at Belmont University in
              Nashville, TN, she moved to the mountains of Colorado, where she
              spent seven years practicing at Howard Head Sports Medicine in
              partnership with Vail Health. There, she worked alongside the
              world-renowned orthopedic surgeons of the Steadman Philippon
              organization, caring for patients with a wide range of orthopedic
              injuries and post-surgical conditions.
            </p>
            <p>
              Known for her compassionate, individualized approach, Dr. Elie was
              honored with a hospital-wide, patient-nominated award for
              excellence in patient care during her time at Howard Head/Vail
              Health. She believes every patient deserves one-on-one care,
              thoughtful treatment, and a plan tailored to their unique goals.
            </p>
            <p>
              Dr. Elie also serves as a physical therapist contractor for the
              United States Tennis Association (USTA) Pro Circuit, working with
              elite tennis athletes and further developing her expertise in
              sports rehabilitation and performance. Her clinical interests
              include persistent pain, golf, tennis, running, barre, and
              orthopedic injuries. As a Titleist Performance Institute (TPI)
              Medical Level 3 certified physical therapist, she is passionate
              about helping golfers move better, play with less pain, and
              perform at their highest level.
            </p>
            <p>
              Through MVMNT Matters, Dr. Elie combines advanced clinical
              expertise with personalized care to help patients recover from
              injury, overcome pain, and confidently return to the activities
              they love.
            </p>
          </div>
        </div>

        <div class="bio flex justify-center md:w-1/3" data-attribute={index}>
          <Image
            src={elieHeadshot}
            alt="Elie Sabins"
            class="w-64 md:w-4/5 rounded-full border-2 border-deep-teal md:translate-y-8"
          />
        </div>
      </div>
    </div>

    <div class="col-span-6 bg-white mb-24">
      <div class="relative bg-white w-full py-24">
        <div
          class="absolute top-0 left-0 w-full overflow-hidden leading-0 -translate-y-full"
        >
          <svg
            preserveAspectRatio="none"
            class="relative block w-full h-24 md:h-52 fill-white"
            xmlns="http://w3.org"
            viewBox="0 0 1440 320"
          >
            <path
              d="M0,192L60,170.7C120,149,240,107,360,101.3C480,96,600,128,720,165.3C840,203,960,245,1080,240C1200,235,1320,181,1380,154.7L1440,128L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"
            ></path>
          </svg>
        </div>

        <SectionHeading class="mb-20 -mt-16 lg:-mt-32 text-5xl"
          >Specialties</SectionHeading
        >
        <div
          class="mx-auto relative grid w-[90%] max-w-6xl grid-cols-1 gap-4
        sm:grid-cols-2 lg:grid-cols-3 lg:gap-8 justify-items-center"
        >
          {
            certifications.map((certification) => (
              <article class="group relative h-100 w-80  overflow-hidden rounded-sm shadow-xl">
                {certification.image && (
                  <Image
                    src={certification.image}
                    alt={certification.name}
                    widths={[320, 480, 640]}
                    sizes="(max-width: 639px) 90vw,
                   (max-width: 1023px) 45vw,
                   22vw"
                    class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                )}

                <div class="absolute inset-0 bg-[#31577b]/60 transition-colors duration-300 group-hover:bg-[#31577b]/90" />
                <div class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-black/10" />
                <div class="relative flex h-full flex-col items-center justify-center px-6 py-10 text-center text-gray-100">
                  <h3 class="max-w-60 text-xl font-bold leading-snug">
                    {certification.name}
                  </h3>

                  <a
                    href={`${import.meta.env.BASE_URL}about/${certification.slug}`}
                    class="mt-6 inline-flex items-center gap-2 border-b border-white pb-1 text-sm font-semibold uppercase tracking-[0.16em]"
                  >
                    Learn More
                    <svg
                      viewBox="0 0 20 20"
                      aria-hidden="true"
                      class="size-3 fill-none stroke-current transition-transform duration-300 group-hover:translate-y-0.5"
                    >
                      <path
                        d="m6 8 4 4 4-4"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
        <div
          class="absolute bottom-0 left-0 w-full overflow-hidden leading-0 translate-y-[99%] -scale-x-100 -scale-y-100 transform"
        >
          <svg
            preserveAspectRatio="none"
            class="relative block w-full h-24 md:h-52 fill-white"
            xmlns="http://w3.org"
            viewBox="0 0 1440 320"
          >
            <path
              d="M0,192L60,170.7C120,149,240,107,360,101.3C480,96,600,128,720,165.3C840,203,960,245,1080,240C1200,235,1320,181,1380,154.7L1440,128L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"
            ></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .bio {
    /* 1. Initial hidden state */
    opacity: 0;
    translate: -5rem 0;
    scale: 1.5;

    /* 2. Transition rules */
    transition-property: opacity, translate, scale;
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;

    /* Pull the index value from the dataset via CSS attr() */
    transition-delay: calc(200ms * var(--i));
    will-change: opacity, translate, scale;
  }
  @media (min-width: 768px) {
    .bio {
      translate: -30rem 0;
      scale: 1.5;
    }
  }

  /* 3. Final visible state triggered by JS */
  .bio.is-in-view {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  .experience {
    opacity: 0;
    transform: translateY(2.5rem);
    transition-property: opacity, transform;
    transition-duration: 1s; /* Pure fades usually feel snappier at 1s instead of 1.5s */
    transition-timing-function: ease-out;

    /* Keeps your staggered layout delay feature active */
    will-change: opacity;
  }

  /* 2. Final visible state triggered by the Observer */
  .experience.fade-in {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  let activeObserver: IntersectionObserver | null = null;

  function initScrollAnimations() {
    // 1. Define the elements and their corresponding active classes
    const configs = [
      { selector: '.bio', activeClass: 'is-in-view' },
      { selector: '.experience', activeClass: 'fade-in' }, // Your new element
    ];

    // 2. Gather all elements that actually exist on the current page
    const elementsToWatch: { element: Element; activeClass: string }[] = [];
    console.log(elementsToWatch);
    configs.forEach(({ selector, activeClass }) => {
      document.querySelectorAll(selector).forEach((el) => {
        elementsToWatch.push({ element: el, activeClass });
      });
    });

    if (elementsToWatch.length === 0) return;

    // 3. Create a single observer instance
    activeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Retrieve the custom class stored on the element's dataset
            const targetClass = (entry.target as HTMLElement).dataset
              .animationClass;
            if (targetClass) {
              entry.target.classList.add(targetClass);
            }
            activeObserver?.unobserve(entry.target);
          }
        });
      },
      {
        rootMargin: '0px 0px -150px 0px',
        threshold: 0.05,
      },
    );

    // 4. Attach the class mapping to the DOM element and start observing
    elementsToWatch.forEach(({ element, activeClass }) => {
      (element as HTMLElement).dataset.animationClass = activeClass;
      activeObserver?.observe(element);
    });
  }

  // Astro Lifecycle Hooks (Keep these exactly as you had them)
  initScrollAnimations();
  document.addEventListener('astro:after-swap', initScrollAnimations);
  document.addEventListener('astro:before-swap', () => {
    if (activeObserver) {
      activeObserver.disconnect();
      activeObserver = null;
    }
  });
</script>
