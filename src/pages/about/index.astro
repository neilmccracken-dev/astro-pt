---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import SpecialtiesStock from "@assets/images/certifications/specialties.jpg";
import AboutPic from "@assets/images/about-image/test-about.jpg";
import OutsidePTPic from "@assets/images/about-image/outside-pt.jpg";
import Background from "@assets/images/about-image/background.jpg";
import Foreground from "@assets/images/about-image/foreground.png";
import StoryImage from "@assets/images/about-image/story.jpg";
import SectionHeading from "../../components/SectionHeading.astro";
import { certifications } from "../../data/certifications";

interface Props {
  index?: number;
}
const { index = 1 } = Astro.props;
const backgroundImg =
  "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?q=80&w=1920&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&sat=-100";

const optimizedBackground = await getImage({
  src: backgroundImg,
  format: "webp",
  inferSize: true,
  widths: [1024, 1440, 1920, 2560],
});
---

<BaseLayout hasWave={false} title="About">
  <section class="relative overflow-hidden">
    <div
      class="relative h-[440px]
           md:h-[520px]
           lg:h-[820px]
           xl:h-[900px]"
    >
      <Image
        src={AboutPic}
        alt="Elie"
        widths={[640, 960, 1200, 1600, 2400]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover
             object-[58%_center]
             md:object-center
             lg:object-[50%_30%]
             xl:right-0
             xl:left-auto
             xl:w-[85%]
             xl:object-[50%_30%]"
      />

      <!-- XL transition into page background -->
      <div
        class="pointer-events-none absolute inset-y-0 hidden
             xl:block
             xl:left-[15%]
             xl:w-56
             xl:-translate-x-1/2
             xl:bg-linear-to-r
             xl:from-gray-100
             xl:via-gray-100/90
             xl:to-transparent"
      >
      </div>

      <!-- Main left-side gradient -->
      <div
        class="pointer-events-none absolute inset-0
             bg-linear-to-r
             from-gray-100 from-0%
             via-gray-100/90 via-42%
             to-transparent to-75%
             
             md:via-38%
             md:to-58%"
      >
      </div>

      <!-- Text overlay -->
      <div
        class="absolute left-6 top-1/2 z-10
             -translate-y-1/2
             text-deeper-teal
             md:left-[8%]
             md:top-1/3"
      >
        <h1
          class="font-cormorant
               text-4xl font-semibold leading-[0.95]
               sm:text-5xl
               md:text-6xl
               lg:text-7xl"
        >
          About Elie
        </h1>

        <p
          class="mt-3 text-base leading-snug text-deeper-teal/90
               sm:text-lg
               md:text-xl
               lg:text-3xl"
        >
          The person behind<br />
          MVMNT Matters.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white px-6 py-14 md:px-10">
    <div
      class="mx-auto lg:max-w-6xl
      rounded-3xl
      bg-sand-bg
      px-7 py-8
      md:px-12 md:py-10
      md:min-h-128"
    >
      <p
        class="text-sm
        md:text-lg
        font-bold
        uppercase
        tracking-[0.16em]
        text-deeper-teal"
      >
        A Note From Elie
      </p>

      <div
        class="mt-5
        max-w-3xl
        font-caveat
        leading-8
        text-lg
        text-[#26333a]
        md:text-2xl
        md:leading-12
        lg:text-3xl"
      >
        <p>
          I started MVMNT Matters because I wanted to practice physical therapy
          differently—to have the time to listen, understand the whole picture,
          and provide truly individualized care.
        </p>

        <p class="mt-5">
          My goal is simple: to help you feel confident in your body and get
          back to the life you want to live.
        </p>
      </div>

      <div
        class="mt-5 flex items-center justify-end gap-3
        pr-2
        font-caveat
        
        text-[#26333a]
        md:text-4xl"
      >
        <span class="h-px w-8 bg-[#26333a]/60"></span>
        <span class="font-signature text-4xl lg:text-6xl">Elie</span>
      </div>
    </div>
  </section>

  <section class="bg-sky-alt-bg">
    <div
      class="mx-auto grid grid-cols-1
         md:min-h-130 md:grid-cols-2
         lg:max-w-none lg:w-full
         lg:h-[650px]
         xl:h-[720px]"
    >
      <!-- Image -->
      <div class="order-2 h-full overflow-hidden">
        <Image
          src={StoryImage}
          alt="Elie outdoors"
          widths={[640, 960, 1200, 1600]}
          sizes="(max-width: 767px) 100vw, 50vw"
          class="h-auto w-full
      md:h-full md:object-cover
      md:object-[50%_80%]"
        />
      </div>

      <!-- Text -->
      <div
        class="order-1 flex items-center
        px-6 py-10
        md:order-1
        md:px-10 md:py-12
        lg:px-14 lg:py-12
        xl:px-16 xl:py-14"
      >
        <div class="mx-auto max-w-xl">
          <p
            class="font-cormorant
            text-xs md:text-2xl font-extrabold uppercase
            tracking-[0.14em]
            text-stone-950"
          >
            My Story
          </p>

          <div
            class="mt-6 space-y-6
            font-raleway
            text-sm leading-7
            text-slate-700
            md:text-base
            md:leading-8"
          >
            <p>
              I’m a Doctor of Physical Therapy with a passion for helping people
              move, perform, and live without limits. I’ve spent the last 7
              years working in orthopedic and sports medicine clinics, treating
              everything from everyday injuries to complex post-surgical cases.
            </p>

            <p>
              I’ve had the privilege of working alongside some of the top
              orthopedic surgeons and clinicians, as well as with athletes of
              all levels—from weekend warriors to professionals.
            </p>

            <p>
              Through it all, I kept coming back to the same belief: better
              outcomes happen when you take the time to build real
              relationships, look at the bigger picture, and create a plan that
              fits your life.
            </p>

            <p>That’s why I created MVMNT Matters.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-sand-bg px-6 py-16 md:px-10 lg:py-20">
    <div class="mx-auto max-w-7xl">
      <!-- Heading -->
      <div class="mb-12 text-center">
        <p
          class="mb-2 text-[11px] font-semibold uppercase tracking-[0.18em]
               text-deeper-teal"
        >
          My Expertise
        </p>

        <h2
          class="font-cormorant text-3xl font-semibold text-stone-950
               md:text-4xl"
        >
          Advanced training. Proven results.
        </h2>
      </div>

      <!-- Certifications -->
      <div
        class="grid grid-cols-1 gap-y-10
        md:grid-cols-2
        md:gap-x-0
        lg:grid-cols-6"
      >
        {
          certifications.map((certification, index) => {
            const Icon = certification.icon;

            return (
              <article
                class:list={[
                  `
                  flex flex-col items-center px-6 text-center
                  lg:min-h-77.5
                `,
                  index !== certifications.length - 1 &&
                    "lg:border-r lg:border-[#163f48]/15",
                ]}
              >
                <div
                  class="
                  mb-5 flex h-14 items-center justify-center
                  text-deeper-teal
                "
                >
                  {Icon ? (
                    <Icon
                      className="size-10 text-deeper-teal"
                      strokeWidth={1.5}
                    />
                  ) : certification.image ? (
                    <Image
                      src={certification.image}
                      alt={certification.name}
                      class="h-14 w-14 object-contain stroke-deeper-teal"
                    />
                  ) : null}
                </div>

                <h3
                  class="h-8
                  text-sm font-bold tracking-wide
                  text-[#15272d]
                "
                >
                  {certification.short}
                </h3>

                <p
                  class="
                  mt-1 max-w-32.5 md:h-10
                  text-[12px] font-semibold leading-5
                  text-[#17252b]
                "
                >
                  {certification.name}
                </p>
                <div class="mx-auto mt-2 h-px w-16 bg-deeper-teal/60 lg:hidden" />

                <p
                  class="
                  mt-4 max-w-40
                  text-sm leading-[1.7]
                  
                "
                >
                  {certification.description}
                </p>
              </article>
            );
          })
        }
      </div>

      <p
        class="mx-auto mt-12 max-w-xl text-center
         leading-6 text-[#273b40]
        md:mt-14"
      >
        I'm committed to ongoing education so I can bring you the most
        effective, up-to-date care possible.
      </p>
    </div>
  </section>

  <section class="bg-sky-alt-bg">
    <div
      class="mx-auto grid grid-cols-1
           md:min-h-130 md:grid-cols-2
           lg:h-112.5 lg:w-full lg:max-w-none
           xl:h-130"
    >
      <div
        class="order-1 flex items-center
             px-6 py-10
             md:px-10 md:py-12
             lg:px-14 lg:py-12
             xl:px-16 xl:py-14"
      >
        <div class="mx-auto max-w-xl">
          <p
            class="font-cormorant text-xs font-bold uppercase
                 tracking-[0.14em] text-stone-950
                 md:text-2xl"
          >
            Outside of PT
          </p>

          <div
            class="mt-6 space-y-6
                 font-raleway text-sm leading-7 text-stone-750
                 md:text-base md:leading-8"
          >
            <p>
              I'm a lifelong lover of movement and the outdoors. You'll find me
              running, golfing, spending time in the mountains, or chasing after
              my two little ones.
            </p>

            <p>
              I understand what it means to juggle a busy life while trying to
              stay active&mdash;and I bring that same balance and perspective to
              the care I provide.
            </p>
          </div>
        </div>
      </div>

      <div class="order-2 h-full overflow-hidden">
        <Image
          src={OutsidePTPic}
          alt="Elie outdoors"
          widths={[640, 960, 1200, 1600]}
          sizes="(max-width: 767px) 100vw, 50vw"
          class="h-auto w-full
               md:h-full md:object-cover"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bio {
    /* 1. Initial hidden state */
    opacity: 0;
    translate: -5rem 0;
    scale: 1.5;

    /* 2. Transition rules */
    transition-property: opacity, translate, scale;
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;

    /* Pull the index value from the dataset via CSS attr() */
    transition-delay: calc(200ms * var(--i));
    will-change: opacity, translate, scale;
  }
  @media (min-width: 768px) {
    .bio {
      translate: -30rem 0;
      scale: 1.5;
    }
  }

  /* 3. Final visible state triggered by JS */
  .bio.is-in-view {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  .specialties {
    opacity: 0;
    transform: translateX(-2.5rem);
    transition-property: opacity, transform;
    transition-duration: 1.5s; /* Pure fades usually feel snappier at 1s instead of 1.5s */
    transition-timing-function: ease-out;

    /* Keeps your staggered layout delay feature active */
    will-change: opacity;
  }

  /* 2. Final visible state triggered by the Observer */
  .specialties.fade-in {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  let activeObserver: IntersectionObserver | null = null;

  function initScrollAnimations() {
    // 1. Define the elements and their corresponding active classes
    const configs = [
      { selector: ".bio", activeClass: "is-in-view" },
      { selector: ".specialties", activeClass: "fade-in" }, // Your new element
    ];

    // 2. Gather all elements that actually exist on the current page
    const elementsToWatch: { element: Element; activeClass: string }[] = [];
    console.log(elementsToWatch);
    configs.forEach(({ selector, activeClass }) => {
      document.querySelectorAll(selector).forEach((el) => {
        elementsToWatch.push({ element: el, activeClass });
      });
    });

    if (elementsToWatch.length === 0) return;

    // 3. Create a single observer instance
    activeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Retrieve the custom class stored on the element's dataset
            const targetClass = (entry.target as HTMLElement).dataset
              .animationClass;
            if (targetClass) {
              entry.target.classList.add(targetClass);
            }
            activeObserver?.unobserve(entry.target);
          }
        });
      },
      {
        rootMargin: "0px 0px -150px 0px",
        threshold: 0.05,
      },
    );

    // 4. Attach the class mapping to the DOM element and start observing
    elementsToWatch.forEach(({ element, activeClass }) => {
      (element as HTMLElement).dataset.animationClass = activeClass;
      activeObserver?.observe(element);
    });
  }

  // Astro Lifecycle Hooks (Keep these exactly as you had them)
  initScrollAnimations();
  document.addEventListener("astro:after-swap", initScrollAnimations);
  document.addEventListener("astro:before-swap", () => {
    if (activeObserver) {
      activeObserver.disconnect();
      activeObserver = null;
    }
  });
</script>
