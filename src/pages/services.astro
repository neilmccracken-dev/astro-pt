        srcset={mobileImage.srcSet.attribute}
        sizes="100vw"
        type="image/webp"
      />

      <Image
        src={HeroPic}
        alt="Elie"
        widths={[300,480, 640, 960, 1200, 1600, 2400]}
        sizes="100vw"
        class="hero-image1"
      />
    </picture>

