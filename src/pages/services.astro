---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image,getImage } from 'astro:assets';
import HeroPic from '@assets/images/services/hero-8.jpg';
import HeroPicMobile from '@assets/images/services/hero-9.jpg';
import {howItWorksSteps} from '../data/howItWorks'
import { ChevronRight, CreditCard, ReceiptText,CircleCheck,ClipboardList,UserRound,Monitor } from 'lucide-react';
import GolfSwing from "../components/GolfSwing.tsx";
import TennisSwing from "../components/svgs/TennisSwing.tsx";
import type { ComponentType, SVGProps } from "react";
type ServiceIcon = ComponentType<SVGProps<SVGSVGElement>>;

type ServiceDisplayConfig = {
  icon: ServiceIcon;
  iconProps?: SVGProps<SVGSVGElement>;
};
const mobileImage = await getImage({
  src: HeroPicMobile,
  widths: [400, 640, 800, 1024],
  sizes: '100vw',
  format: 'webp',
});

const serviceEntries=await getCollection('services')

const serviceIconConfig: Record<string, ServiceDisplayConfig> = {
  "tennis-assessment": {
    icon: TennisSwing,
    iconProps: {
      width: 64,
      height: 64,
    },
  },

  "golf-assessment": {
    icon: GolfSwing,
    iconProps: {
      width: 56,
      height: 56,
    },
  },
    "evaluation": {icon:ClipboardList},
  "follow-up-visit":{icon:UserRound},
  "virtual-follow-up-visit":{icon:Monitor},
}
const services = serviceEntries.map((service) => ({
  ...service.data,
   ...serviceIconConfig[
    service.id as keyof typeof serviceIconConfig
  ],
}));
