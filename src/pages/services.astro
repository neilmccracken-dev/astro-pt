  position: relative;
  overflow: hidden;
  height: 430px;
}
.hero-gradient2 {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, #f9fafb 0%, rgb(243 244 246 / 75%) 30%, transparent 60%);
}
/* Image-edge fade follows the image's left boundary. */
.hero-edge-gradient2 {
  position: absolute;
  top: 0;
  bottom: 0;
  left: calc(37% + -25px);
  width: 100px;
  transform: translateX(-50%);
  pointer-events: none;
  background: linear-gradient(to right, #f9fafb 0%, rgb(243 244 246 / 100%) 82%, transparent 100%);
  display: block;
}
   }

