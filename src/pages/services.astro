---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
// const services = await getCollection('services');
import { Image } from 'astro:assets';
import HeroPic from '@assets/images/services/hero.jpg';
import {services} from '../data/services'
import {howItWorksSteps} from '../data/howItWorks'
import { ChevronRight, CreditCard, ReceiptText, Check,MoveRight,CircleCheck } from 'lucide-react';


---

<BaseLayout title="Services" hasWave={false}>
  <section class="relative overflow-hidden">
    <div
      class="relative h-80 p-4
           md:h-80
           lg:h-155
           xl:h-200"
    >
      <Image
        src={HeroPic}
        alt="Elie"
        widths={[640, 960, 1200, 1600, 2400]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover
             object-[58%_center]
             md:object-center
             lg:object-[50%_30%]
             xl:right-0
             xl:left-auto
             xl:w-[85%]
             xl:object-[50%_30%]"
      />

      <!-- XL transition into page background -->
      <div
        class="pointer-events-none absolute inset-y-0 hidden
             xl:block
             xl:left-[15%]
             xl:w-56
             xl:-translate-x-1/2
             xl:bg-linear-to-r
             xl:from-gray-100
             xl:via-gray-100/90
             xl:to-transparent"
      >
      </div>

      <!-- Main left-side gradient -->
      <div
        class="pointer-events-none absolute inset-0
             bg-linear-to-r
             from-gray-100 from-0%
             via-gray-100/90 via-42%
             to-transparent to-75%
             
             md:via-38%
             md:to-58%"
      >
      </div>

      <!-- Text overlay -->
      <div
        class="absolute left-6 top-1/2 z-10
             -translate-y-1/4
             md:left-[8%]
             md:top-1/3"
      >
        <h1
          class="font-serif
             text-deeper-teal
               text-2xl leading-[0.95]
               sm:text-4xl
               md:text-6xl
               lg:text-6xl"
        >
          Simple Pricing
        </h1>

        <p
          class="mt-3 font-serif text-lg italic leading-snug text-cyan-800
               sm:text-xl
               md:text-2xl
               lg:text-5xl"
        >
          Meaningful Care
        </p>
        <div class="mt-5 h-px w-12 bg-deeper-teal"></div>
        <p
          class="mt-12 text-stone-950 text-xs lg:text-lg w-36 md:w-96 md:leading-8"
        >
          One-on-one physical therapy that comes to you—<br />so you can get
          better without putting your life on hold.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-ivory px-6 py-12 md:py-12">
  <div class="mx-auto max-w-6xl">

    <div class="mb-4 text-center">
      <p
        class="mb-2 text-xs font-semibold uppercase tracking-[0.15em]
               text-deeper-teal"
      >
        Invest in your health
      </p>

      <h2
        class="font-serif text-2xl font-normal text-deeper-teal
               md:text-3xl"
      >
        Choose the care that fits your goals.
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => {
          const Icon = service.icon;

          return (
            <article
              class="relative overflow-visible rounded-lg"
            >


              <!-- Card -->
              <div
                class="relative h-full min-h-110 overflow-hidden
                       rounded-lg"
              >
                <!-- Background -->
                <img
                  src={service.image.src}
                  alt=""
                  class="absolute inset-0 h-full w-full object-cover
                         transition duration-500
                         group-hover:scale-[1.03]"
                />

                <!-- Overlay -->
              <div
              class="absolute inset-0
         bg-linear-to-b
         from-[#294554]/75
         via-[#19394A]/80
         to-black/80"
          ></div>

                <div
                  class="relative z-10 flex h-full min-h-110
                         flex-col items-center px-7 py-8
                         text-center text-white"
                >
                  <div
                    class="mb-5 flex size-24 items-center
                           justify-center rounded-full
                           border border-white/70"
                  >
                    <Icon
                      width={36}
                      height={36}
                      strokeWidth={1.5}
                      {...service.iconProps}
                    />
                  </div>

                  <h3
                    class="text-xs font-medium uppercase
                           tracking-[0.14em]"
                  >
                    {service.name}
                  </h3>

  

                  <p
                    class="mt-2 text-[10px] font-semibold
                           uppercase tracking-[0.12em]"
                  >
                    {service.duration}
                  </p>

                  <p
                    class="mt-5 max-w-64 
                           leading-6 text-white/90"
                  >
                    {service.description}
                  </p>

                  <div class="mt-auto w-full pt-6">
                    <div class="mb-5 h-px bg-white/40" />

                    <a
                      href='#'
                      class="inline-flex items-center gap-3
                             text-xs font-semibold uppercase
                             tracking-[0.14em]
                             transition-all
                             hover:gap-5"
                    >
                      Learn More
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<section class="bg-sky-alt-bg py-12" >
  <header class="mb-12 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-deeper-teal">
        How It Works
      </p>

      <h2 class="mt-2 font-serif text-2xl text-deeper-teal md:text-3xl">
        Expert care, made simple.
      </h2>
    </header>
<div class="px-2 mx-auto max-w-7xl  grid grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] ">
  {
    howItWorksSteps.map((step, index) => {
      const Icon = step.Icon;

      return (
        <>
<div class="flex min-w-0 flex-col items-center text-center">

  <!-- Number + Icon -->
<div class="flex justify-center md:grid w-full md:grid-cols-[1fr_auto_1fr] md:items-start">
  <span class="hidden md:flex size-8 items-center justify-center
           rounded-full border border-deeper-teal/80
           text-xs font-semibold bg-deeper-teal/80 text-white"
    >
    {step.id}
  </span>

  <Icon
    strokeWidth={1.25}
    className="text-deeper-teal size-10 md:size-12"
  />

  <span></span>
</div>

  <h3
    class="mt-4 text-xs md:text-sm font-semibold uppercase
           tracking-wide text-stone-950"
  >
    {step.title}
  </h3>

  <p class="mt-3 text-stone-950 hidden max-w-52 text-xs md:text-sm leading-6 md:block">
    {step.description}
  </p>

</div>

          <!-- Arrow between steps -->
          {index < howItWorksSteps.length - 1 && (
            <div class="flex justify-center h-20 items-center px-1 sm:px-3 md:px-6">
              <ChevronRight
                
                strokeWidth={1.25}
                className="text-deeper-teal/80 size-8 md:size-12"
              />
            </div>
          )}
        </>
      );
    })
  }
</div>
    <div
    class="mx-auto w-1/3   mt-16
           border-t border-deeper-teal/40"
  ></div>
<div
    class="mx-auto grid w-full max-w-7xl gap-12
           md:grid-cols-2 md:gap-0 px-6 py-12 md:py-20"
  >

    <!-- Payment -->
    <div class="md:pr-12 lg:pr-16">
      <div class="mb-6 flex items-center justify-center md:justify-start gap-3 ">
        <CreditCard
          strokeWidth={1.25}
          className="size-8 text-deeper-teal"
        />

        <h2 class=" font-raleway text-2xl font-semibold text-deeper-teal">
          Payment
        </h2>
      </div>

      <p class="max-w-xl leading-relaxed text-stone-800">
        Payment is due at the time of service. We accept:
      </p>

      <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-4">
        <div class="flex items-center gap-2">
          <CircleCheck className="size-4 shrink-0 text-deeper-teal" />
          <span>Credit cards</span>
        </div>

        <div class="flex items-center gap-2">
          <CircleCheck className="size-4 shrink-0 text-deeper-teal" />
          <span>Debit cards</span>
        </div>

        <div class="flex items-center gap-2">
          <CircleCheck className="size-4 shrink-0 text-deeper-teal" />
          <span>HSA / FSA</span>
        </div>

        <div class="flex items-center gap-2">
          <CircleCheck className="size-4 shrink-0 text-deeper-teal" />
          <span>Cash</span>
        </div>
      </div>
    </div>

    <!-- Insurance -->
    <div
      class="border-t border-deeper-teal/20 pt-10
             md:border-t-0 md:border-l md:pt-0 md:pl-12
             lg:pl-16"
    >
      <div class="mb-6 flex items-center justify-center md:justify-start gap-3">
        <ReceiptText
          strokeWidth={1.25}
          className="size-8 text-deeper-teal"
        />

        <h2 class="font-raleway text-2xl font-semibold text-deeper-teal">
          Insurance & Superbills
        </h2>
      </div>

      <p class="max-w-xl leading-relaxed text-stone-800">
        MVMNT Matters is a cash-based practice and does not bill insurance
        directly.
      </p>

      <p class="mt-4 max-w-xl leading-relaxed text-stone-800">
        A superbill can be provided for you to submit to your insurance
        company for possible out-of-network reimbursement.
      </p>

      <a
        href="/contact"
        class="mt-6 inline-flex items-center font-semibold
               text-deeper-teal uppercase"
      >
        Learn more about Superbills
        <MoveRight className='ml-2' />
      </a>
    </div>
  </div>

</section>
</BaseLayout>

