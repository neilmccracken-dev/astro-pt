---
import { ChevronDown, ChevronRight } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';

import HeroPic from '@assets/images/faq-page/hero-7.jpg';

const faqs = await getCollection('faqs');
const categories = [
  {
    label: 'Getting Started',
    value: 'getting-started',
  },
  {
    label: 'Specialties',
    value: 'specialties',
  },
  {
    label: 'Payment & Insurance',
    value: 'payment-insurance',
  },
  {
    label: 'Appointments & Treatment',
    value: 'appointments-treatment',
  },
];

const groupedFaqs = categories.map((category) => ({
  ...category,

  faqs: faqs
    .filter((faq) => faq.data.category === category.value)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<BaseLayout title="faq" hasWave={false}>
  <section class="relative overflow-hidden">
    <div
      class="relative h-90
           md:h-140
           lg:h-185
           xl:h-205"
    >
      <Image
        src={HeroPic}
        alt="Elie"
        widths={[640, 960, 1200, 1600, 2400]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover
         object-[70%_50%]
         md:object-center
         lg:object-[50%_50%]
         lg:w-[85%]
         lg:left-auto
         lg:right-0
         xl:w-[70%]
         xl:object-[50%_60%]"
      />

      <!-- XL transition into page background -->
      <div
        class="pointer-events-none absolute inset-y-0 hidden
           lg:block
         lg:left-[15%]
         lg:w-56
         lg:-translate-x-1/2
         lg:bg-linear-to-r
         lg:from-gray-100
         lg:via-gray-100/90
         lg:to-transparent
         xl:left-[30%]
         xl:w-64"
      >
      </div>

      <!-- Main left-side gradient -->
      <div
        class="pointer-events-none absolute inset-0
             bg-linear-to-r
             from-gray-100 from-0%
             via-gray-100/80 via-35%
             to-transparent to-52%
             
             md:via-38%
             md:to-58%"
      >
      </div>

      <!-- Text overlay -->
      <div
        class="absolute left-6 top-1/2 z-10
             -translate-y-1/2
             text-deeper-teal
             md:left-[8%]
             md:top-1/3"
      >
        <h1
          class="text-reveal font-cormorant
               text-2xl font-semibold leading-[0.95]
               sm:text-4xl
               md:text-5xl
               lg:text-6xl"
        >
          FAQ
        </h1>

        <p
          class="text-reveal-late mt-3 text-base leading-snug text-deeper-teal/90
               sm:text-lg
               md:text-xl
               lg:text-3xl"
        >
          The person behind<br />
          MVMNT Matters
        </p>
      </div>
    </div>
  </section>

  <div class="bg-sand-bg">
    <section class="mx-auto max-w-4xl px-6 py-16">
      <h1 class="mb-10 text-center text-3xl font-semibold text-stone-950">
        Frequently Asked Questions
      </h1>

      {
        groupedFaqs.map((group) => (
          <div class="mb-12">
            <h2 class="mb-2 text-xl font-semibold text-deeper-teal ">
              {group.label}
            </h2>
            <div class="mt-2 h-px w-12 bg-" />

            <div class="space-y-3">
              {group.faqs.map((faq) => (
                <details class="group text-sm md:text-lg collapse border-b border-deeper-teal/40">
                  <summary class=" collapse-title flex cursor-pointer items-center justify-between text-stone-800 ">
                    <span>{faq.data.question}</span>

                    <ChevronRight
                      className="size-5 shrink-0 transition-transform duration-300 group-open:rotate-90"
                      strokeWidth={1.5}
                    />
                  </summary>

                  <div class="collapse-content">
                    <p class="text-base whitespace-pre-wrap leading-relaxed">
                      {faq.data.answer}
                    </p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  details::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size 300ms ease,
      opacity 200ms ease,
      content-visibility 300ms allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
</style>
