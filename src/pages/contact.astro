---
import BaseLayout from '../layouts/BaseLayout.astro';
const contactEmail = 'mccrackenneild@gmail.com';
---

<BaseLayout hasWave={true} title={'contact'}>
  <section
    class="relative overflow-hidden bg-white md:px-4 lg:pt-16 sm:pb-16 sm:px-0 lg:px-8 mb-48"
  >
    <!-- Soft background glow -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-white md:bg-[radial-gradient(circle_at_center,rgba(163,230,53,0.18),transparent_55%)]"
    >
    </div>

    <div
      class="mx-auto grid w-full max-w-7xl overflow-hidden lg:rounded-2xl
      shadow-2xl lg:grid-cols-[0.95fr_1.05fr]"
    >
      <!-- Left panel -->
      <div
        class="relative flex flex-col justify-center bg-deeper-teal px-8 py-12 text-neutral-content sm:px-12 lg:px-16 lg:py-20"
      >
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_right,rgba(125,211,252,0.30),transparent_50%)]"
        >
        </div>

        <div class="relative max-w-lg">
          <p
            class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-light-blue"
          >
            Contact Dr. Elie
          </p>

          <h2
            class="max-w-md text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl"
          >
            Let's Connect
          </h2>

          <p
            class="mt-6 max-w-md text-base leading-relaxed text-neutral-content/70"
          >
            Complete the form and I will respond as soon as possible.
          </p>

          <ul class="mt-10 space-y-5">
            <li class="flex items-start gap-4">
              <span
                class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-light-blue text-sm font-bold text-neutral"
                aria-hidden="true"
              >
                ✓
              </span>

              <span class="text-neutral-content/85">
                Expect a response within one business day.
              </span>
            </li>

            <li class="flex items-start gap-4">
              <span
                class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-light-blue text-sm font-bold text-neutral"
                aria-hidden="true"
              >
                ✓
              </span>

              <span class="text-neutral-content/85">
                Your information will remain private.
              </span>
            </li>

            <li class="flex items-start gap-4">
              <span
                class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-light-blue text-sm font-bold text-neutral"
                aria-hidden="true"
              >
                ✓
              </span>

              <span class="text-neutral-content/85">
                We are happy to answer any initial questions.
              </span>
            </li>
          </ul>

          <div class="mt-10">
            <p class="text-sm text-neutral-content/60">Prefer email?</p>

            <a
              href={`mailto:${contactEmail}`}
              class="mt-1 inline-block font-medium underline decoration-light-blue decoration-2 underline-offset-4 transition hover:text-light-blue"
            >
              {contactEmail}
            </a>
          </div>
        </div>
      </div>

      <!-- Form panel -->
      <div class="bg-sky px-5 py-8 sm:px-10 sm:py-12 lg:px-14 lg:py-16">
        <form
          name="contact"
          method="POST"
          id="contact-form"
          class="rounded-2xl p-6 sm:p-8"
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <!-- First name -->
            <label class="form-control w-full">
              <span class="mb-2 text-sm font-medium">First name</span>

              <input
                type="text"
                name="firstName"
                autocomplete="given-name"
                placeholder="Enter your first name"
                required
                class="input input-bordered w-full bg-base-100 focus:border-lime-500 focus:outline-none"
              />
            </label>

            <!-- Last name -->
            <label class="form-control w-full">
              <span class="mb-2 text-sm font-medium">Last name</span>

              <input
                type="text"
                name="lastName"
                autocomplete="family-name"
                placeholder="Enter your last name"
                required
                class="input input-bordered w-full bg-base-100 focus:border-lime-500 focus:outline-none"
              />
            </label>

            <!-- Email -->
            <label class="form-control w-full sm:col-span-2">
              <span class="mb-2 text-sm font-medium">Email</span>

              <input
                type="email"
                name="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
                class="input input-bordered w-full bg-base-100 focus:border-lime-500 focus:outline-none"
              />
            </label>

            <!-- Subject -->
            <label class="form-control w-full sm:col-span-2">
              <span class="mb-2 text-sm font-medium">Subject</span>

              <input
                type="text"
                name="subject"
                placeholder="How can we help?"
                required
                class="input input-bordered w-full bg-base-100 focus:border-lime-500 focus:outline-none"
              />
            </label>

            <!-- Message -->
            <label class="form-control w-full sm:col-span-2">
              <span class="mb-2 text-sm font-medium">Message</span>

              <textarea
                name="message"
                rows="7"
                placeholder="Write your message here..."
                required
                class="textarea textarea-bordered w-full resize-y bg-base-100 leading-relaxed focus:border-sky focus:outline-none"
              ></textarea>
            </label>
            <div
              class="sm:col-span-2 rounded-lg border border-amber-300 bg-amber-50 p-4"
            >
              <p class="text-xs leading-relaxed text-base-content/80">
                <strong
                  >Please do not include protected health information (PHI).</strong
                >
                This contact form is intended for general inquiries only. Do not include
                medical history, diagnoses, treatment information, or other sensitive
                health information in the subject or message.
              </p>
            </div>
          </div>

          <div
            class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
          >
            <p class="text-sm text-base-content/60">All fields are required.</p>

            <button
              type="submit"
              class="btn bg-black text-white hover:bg-blue-500"
            >
              Send message
              <span aria-hidden="true">↗</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const data = Object.fromEntries(new FormData(form));

    console.log(data);

