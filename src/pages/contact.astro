---
import { Image, getImage } from 'astro:assets';
import HeroPic from '@assets/images/services/hero.jpg';
import HeroPicMobile from '@assets/images/services/hero-mobile.jpg';
import { Mail, Phone } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
const contactEmail = 'elie@mvmntmatterspt.com';
const contactPhone = '303-555-1234';
const contactEndpoint = import.meta.env.DEV
  ? '/.netlify/functions/test'
  : 'https://pt-project.netlify.app/.netlify/functions/test';

const mobileImage = await getImage({
  src: HeroPicMobile,
  widths: [400, 640, 800, 1024],
  sizes: '100vw',
  format: 'webp',
});
---

<BaseLayout hasWave={false} title="let's connect">
  <section class="relative overflow-hidden bg-gray-50">
    <div class="relative hero-container">
      <picture>
        <source
          media="(max-width: 600px)"
          srcset={mobileImage.srcSet.attribute}
          sizes="100vw"
          type="image/webp"
        />

        <Image
          src={HeroPic}
          alt="Elie"
          widths={[350, 480, 640, 960, 1200, 1600, 2400]}
          sizes="100vw"
          class="hero-image"
        />
      </picture>

      <div class="hero-edge-gradient"></div>

      <div class="hero-gradient"></div>

      <!-- Text overlay -->
      <div
        class="absolute left-2 top-1/4 z-10
             -translate-y-1/4
             md:left-[8%]
             md:top-1/3
             max-w-lg"
      >
        <h1
          class="text-reveal font-serif
             text-deeper-teal
               text-xl leading-[0.95]
               sm:text-2xl
               md:text-3xl
               lg:text-5xl"
        >
          Let's Connect
        </h1>

        <!-- <div class="text-reveal-late">
          <div class="mt-5 h-px w-12 bg-deeper-teal"></div>
          <p
            class="mt-6 md:mt-12 w-40 lg:w-3/4 text-stone-950 text-xs md:text-lg leading-6 md:leading-8"
          >
            One-on-one physical therapy that comes to you—so you can get better
            without putting your life on hold.
          </p>
        </div> -->
      </div>
    </div>
  </section>
  <section
    class="text-reveal relative overflow-hidden md:px-4 lg:pt-16 sm:pb-16 sm:px-0 lg:px-8"
  >
    <div
      class="mx-auto grid w-full max-w-7xl overflow-hidden lg:rounded-2xl
      shadow-2xl lg:grid-cols-[0.95fr_1.05fr]"
    >
      <!-- Left panel -->
      <div
        class="relative flex flex-col justify-center bg-sand-bg px-8 py-12 text-neutral-content sm:px-12 lg:px-16 lg:py-20"
      >
        <div class="relative max-w-lg">
          <p
            class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-deeper-teal"
          >
            Contact Dr. Elie
          </p>

          <h2
            class="max-w-md text-stone-950 text-4xl font-semibold leading-tight sm:text-5xl lg:text-6xl"
          >
            Let's Connect
          </h2>

          <p class="mt-6 max-w-md text-base leading-relaxed text-stone-800">
            Complete the form and I will respond as soon as possible.
          </p>

          <ul class="mt-10 space-y-5">
            <li class="flex items-start gap-4">
              <span
                class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-deeper-teal text-sm font-bold text-white"
                aria-hidden="true"
              >
                ✓
              </span>

              <span class="text-stone-950">
                Expect a response within one business day.
              </span>
            </li>

            <li class="flex items-start gap-4">
              <span
                class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-deeper-teal text-white text-sm font-bold"
                aria-hidden="true"
              >
                ✓
              </span>

              <span class="text-stone-950">
                Your information will remain private.
              </span>
            </li>

            <li class="flex items-start gap-4">
              <span
                class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-deeper-teal text-white text-sm font-bold"
                aria-hidden="true"
              >
                ✓
              </span>

              <span class="text-stone-950">
                We are happy to answer any initial questions.
              </span>
            </li>
          </ul>

          <div class="mt-10 flex flex-col">
            <p class="text-sm text-deeper-teal font-semibold">
              Feel free to also contact me at:
            </p>

            <div
              class="flex flex-col items-start md:flex-row gap-2 mt-2 text-stone-950"
            >
              <a
                href={`mailto:${contactEmail}`}
                class="flex items-center gap-2 font-medium transition hover:text-light-blue"
              >
                <Mail className=" size-4 shrink-0" strokeWidth={1.5} />
                <span>{contactEmail}</span>
              </a>
              <!-- <span class="h-4 w-px bg-white/30" aria-hidden="true"></span> -->
              <a
                href="tel:303-555-1234"
                class="flex items-center gap-2 font-medium transition hover:text-light-blue"
              >
                <Phone className="size-4 shrink-0" strokeWidth={1.5} />
                <span>{contactPhone}</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Form panel -->
      <div class="bg-sky-alt-bg px-5 py-8 sm:px-10 sm:py-12 lg:px-14 lg:py-16">
        <form
          name="contact"
          method="POST"
          data-endpoint={contactEndpoint}
          id="contact-form"
          class="rounded-2xl p-6 sm:p-8"
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <!-- First name -->
            <label class="form-control w-full">
              <span class="mb-2 text-sm font-medium">First name</span>

              <input
                type="text"
                name="firstName"
                autocomplete="given-name"
                placeholder="Enter your first name"
                required
                class="input input-bordered w-full bg-base-100 focus:border-lime-500 focus:outline-none"
              />
            </label>
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="contact-check">Website</label>
              <input
                id="contact-check"
                type="text"
                name="contact_check"
                tabindex="-1"
                autocomplete="new-password"
              />
            </div>

            <!-- Last name -->
            <label class="form-control w-full">
              <span class="mb-2 text-sm font-medium">Last name</span>

              <input
                type="text"
                name="lastName"
                autocomplete="family-name"
                placeholder="Enter your last name"
                required
                class="input input-bordered w-full bg-base-100 focus:border-lime-500 focus:outline-none"
              />
            </label>

            <!-- Email -->
            <label class="form-control w-full sm:col-span-2">
              <span class="mb-2 text-sm font-medium">Email</span>

              <input
                type="email"
                name="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
                class="input input-bordered w-full bg-base-100 focus:border-lime-500 focus:outline-none"
              />
            </label>

            <!-- Subject -->
            <label class="form-control w-full sm:col-span-2">
              <span class="mb-2 text-sm font-medium">Subject</span>

              <input
                type="text"
                name="subject"
                placeholder="How can we help?"
                required
                class="input input-bordered w-full bg-base-100 focus:border-lime-500 focus:outline-none"
              />
            </label>

            <!-- Message -->
            <label class="form-control w-full sm:col-span-2">
              <span class="mb-2 text-sm font-medium">Message</span>

              <textarea
                name="message"
                rows="7"
                placeholder="Write your message here..."
                required
                class="textarea textarea-bordered w-full resize-y bg-base-100 leading-relaxed focus:border-sky focus:outline-none"
              ></textarea>
            </label>
            <div class="sm:col-span-2 rounded-lg bg-sand-bg p-4">
              <p
                class="text-xs md:text-sm leading-relaxed text-base-content/80"
              >
                <strong
                  >Please do not include protected health information (PHI).</strong
                >
                This contact form is intended for general inquiries only. Do not include
                medical history, diagnoses, treatment information, or other sensitive
                health information in the subject or message. My website is striclty
                informational to protect your data. Once you become a client, all
                official scheduling and secure communication will take place through
                Jane App's dedicated client platform.
              </p>
            </div>
          </div>

          <div
            class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
          >
            <p class="text-sm text-stone-850">All fields are required.</p>

            <button
              type="submit"
              class="btn bg-blue-900 tracking-wider border-0 text-gray-100 hover:bg-blue-500"
            >
              Send message
              <span aria-hidden="true">↗</span>
            </button>
          </div>
          <div
            id="form-toast"
            class="mt-4 hidden"
            role="status"
            aria-live="polite"
          >
            <div id="form-toast-alert" class="alert">
              <span id="form-toast-message"></span>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  function showToast(message: string, type: 'success' | 'error') {
    const toast = document.querySelector<HTMLDivElement>('#form-toast');
    const alert = document.querySelector<HTMLDivElement>('#form-toast-alert');
    const toastMessage = document.querySelector<HTMLSpanElement>(
      '#form-toast-message',
    );

    if (!toast || !alert || !toastMessage) return;

    toastMessage.textContent = message;

    alert.classList.remove('alert-success', 'alert-error');

    alert.classList.add(type === 'success' ? 'alert-success' : 'alert-error');

    toast.classList.remove('hidden');

    setTimeout(() => {
      toast.classList.add('hidden');
    }, 5000);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const data = Object.fromEntries(new FormData(form));
    const endpoint = form.dataset.endpoint;
    if (!endpoint) return;

    const response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(data),
    });

    const result = await response.json();

    if (!response.ok) {
      showToast(
        result.message || 'Something went wrong. Please try again.',
        'error',
      );
      return;
    }
    showToast('Thanks! Your message has been sent.', 'success');

    form.reset();
  });
</script>

<style>
  @media (min-width: 380px) {
    /* mobile — viewport 440px */
    .hero-image {
      width: 80%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 50%;
      position: absolute;
      right: 0;
      top: 0;
    }
    .hero-container {
      position: relative;
      overflow: hidden;
      height: 500px;
    }
    .hero-gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        #f9fafb 0%,
        rgb(243 244 246 / 55%) 37%,
        transparent 56%
      );
    }
    /* Image-edge fade follows the image's left boundary. */
    .hero-edge-gradient {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(20% + 30px);
      width: 156px;
      transform: translateX(-50%);
      pointer-events: none;
      background: linear-gradient(
        to right,
        #f9fafb 0%,
        rgb(243 244 246 / 91%) 68%,
        transparent 100%
      );
      display: block;
    }
  }
  @media (min-width: 1150px) {
    .hero-image {
      width: 85%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 50%;
      position: absolute;
      right: 0;
      top: 0;
    }
    .hero-container {
      position: relative;
      overflow: hidden;
      height: 720px;
    }
    .hero-gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        #f3f4f6 0%,
        rgb(243 244 246 / 90%) 28%,
        transparent 47%
      );
    }
    /* Image-edge fade follows the image's left boundary. */
    .hero-edge-gradient {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(15% + 90px);
      width: 312px;
      transform: translateX(-50%);
      pointer-events: none;
      background: linear-gradient(
        to right,
        #f3f4f6 0%,
        rgb(243 244 246 / 90%) 50%,
        transparent 100%
      );
      display: block;
    }
  }
</style>
