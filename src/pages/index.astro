---
import AutoCarousel from '../components/Carousel';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage,Image } from 'astro:assets';
import LogoStacked from '@assets/images/mvnmt-logo-stacked-black.svg';
import LogoStackedColor from '@assets/images/mvmnt-logo-stacked-color.svg';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import type { Testimonial } from '../components/TestimonialCarousel';
import TestimonialCarousel from '../components/TestimonialCarousel';
import elieHeadshot from '@assets/images/headshot.jpg';

const testimonials = await getCollection('testimonials');
const formattedTestimonials: Testimonial[] = testimonials.map((item) => ({
  review: item.data.review,
  name: item.data.name,
  relationship: item.data.relationship,
  headline: item.data.relationship,
}));

const servicesWeTreat = [
  "Back & Neck Pain",
  "Golf Rehab & Performance",
  "Shoulder Pain",
  "Post-Surgical Rehab",
  "Knee & Hip Pain",
  "Strength & Conditioning",
  "Running Injuries",
  "Balance & Mobility",
  "Tennis Injuries",
  "Persistent Pain",
];

import neckPain from "@assets/images/we-treat/neck-pain.jpg";
import golfSwing from "@assets/images/we-treat/golf-swing.jpg";
import tyingShoes from "@assets/images/we-treat/tying-shoes.jpg";
import strength from "@assets/images/we-treat/strength.jpg";

const images = [
  { src: neckPain, alt: "Neck pain treatment" },
  { src: golfSwing, alt: "Golf rehabilitation" },
  { src: tyingShoes, alt: "running" },
  { src: strength, alt: "strength and conditioning" },
];

import {
  House,
  UserRound,
  Mountain,
  Heart,
  DollarSign,
  ArrowRight,
  CircleCheck
} from 'lucide-react';

const features = [
  {
    title: 'Mobile & Convenient',
    description:
      'We come to you, saving you time and making quality care easy.',
    icon: House,
  },
  {
    title: 'One-on-One Expert Care',
    description:
      'You get our full attention and a plan tailored specifically to you.',
    icon: UserRound,
  },
  {
    title: 'Advanced Training. Better Outcomes.',
    description:
      'Specialized expertise across orthopedics, pain, performance, and more.',
    icon: Mountain,
  },
  {
    title: 'Whole-Person Approach',
    description:
      'We treat the root cause—not just the symptom—so you can thrive long term.',
    icon: Heart,
  },
  {
    title: 'Transparent Pricing',
    description: 'Cash-based care with clear pricing and no surprises.',
    icon:DollarSign,
  },
];
const unsplashUrls = [
  {
    url: 'https://plus.unsplash.com/premium_photo-1664300093125-92bc8a26d3fa?q=80&w=1171&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    focalY: 0.75,
    ar: '16:9',
    isTall: false,
  },
  {
    url: 'https://images.unsplash.com/photo-1608561807980-6e39958ae1c8?q=80&w=764&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    focalY: 0.65,
    ar: '4:3',
    isTall: true,
  },
  {
    url: 'https://images.unsplash.com/photo-1628609108761-7d1dbec20e4a?q=80&w=735&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    focalY: 0.45,
    ar: '4:3',
    isTall: true,
  },
];

// Map over your URLs and run them through Astro's image optimization engine
// const optimizedImages = await Promise.all(
//   unsplashUrls.map(async (item) => {
//     const modifiedUrl = `${item.url}?fit=crop&crop=focalpoint&ar=${item.ar}&fp-x=0.5&fp-y=${item.focalY}`;

//     const optimized = await getImage({
//       src: modifiedUrl,
//       inferSize: true,
//       widths: [240, 540, 720, 1024],
//       // Unsplash specific formatting parameter shortcut
//       format: 'webp',
//     });
//     return {
//       ...optimized,
//       isTall: item.isTall,
//     };
//   }),
// );
const sizesAttribute = `(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1024px) 720px, 1024px`;
const optimizedBg = await getImage({
  src: 'https://images.unsplash.com/photo-1527856263669-12c3a0af2aa6?q=80&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
  inferSize: true,
  widths: [360, 480, 640, 768, 1024, 1440, 1920],
  format: 'webp',
});
const bgSizesAttribute = `
  (max-width: 640px) 100vw,
  (max-width: 1024px) 100vw,
  100vw
`;
---

<BaseLayout title="" hasWave={false} isHome={true}>
  <main class="relative w-full min-h-screen flex flex-col" id="theme-preview" data-theme="default">
    <div class="relative w-full h-[60vh] md:h-[80vh] overflow-hidden z-0">
      <img
        src={optimizedBg.src}
        alt="Avatar"
        srcset={optimizedBg.srcSet.attribute}
        sizes={bgSizesAttribute}
        alt="Page background"
        loading="eager"
        decoding="sync"
        class="w-full h-full object-cover object-[40%_center]"
      />
      <!-- Light gradient overlay -->
      <div
        class="absolute inset-0
           bg-[linear-gradient(90deg,rgba(245,243,245,0.98)_0%,rgba(245,243,245,0.93)_28%,rgba(245,243,245,0.75)_50%,rgba(245,243,245,0.10)_72%,rgba(245,243,245,0)_100%)]"
      >
      </div>

      <!-- Hero content -->
      <div class="absolute inset-0 flex items-center px-6 md:px-16 lg:px-24">
        <div class="max-w-6xl">
          <h1
            class="text-4xl md:text-6xl font-cabin-[100] font-semibold
         leading-[1.05] text-[#000A14] animate-[textReveal_1s_cubic-bezier(0.25,1,0.5,1)_0.25s]"
          >
            Mobile care
            <br />
            <span class="whitespace-nowrap">
              for
              <span class="font-serif italic text-5xl font-light text-blue-800">
                modern life.
              </span>
            </span>
          </h1>

          <!-- Small divider -->
          <div class="mt-5 h-px w-8 bg-deeper-teal "></div>

          <div class="animate-[textReveal_1s_cubic-bezier(0.25,1,0.5,1)_0.5s]">
            <p
              class="mt-5 max-w-sm text-sm md:text-base
                 leading-relaxed text-[#111820]"
            >
              Premium, one-on-one physical therapy delivered to you—wherever you
              are.
            </p>
            <a
              href="/contact"
              class="mt-6 inline-flex items-center gap-2
                 rounded-full bg-blue-900
                 px-10 py-3
                 text-xs font-semibold uppercase tracking-widest
                 text-white
                 transition hover:opacity-90"
            >
              Book your visit
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="flex">
      <button class="btn bg-green-400 w-16" data-theme-button="default" >Change 1</button>
      <button class="btn bg-green-400 w-16" data-theme-button="option-1">Change 2</button>
      <button class="btn bg-green-400 w-16" data-theme-button="option-2">Change 3</button>
      <button class="btn bg-green-400 w-16" data-theme-button="option-3">Change 4</button>
      <button class="btn bg-green-400 w-16" data-theme-button="option-4">Change 5</button>
      <button class="btn bg-green-400 w-16" data-theme-button="option-5">Change 6</button>
    </div>
    <section class="[background:var(--mission-bg)]">
      <div
        class="mx-auto grid max-w-7xl grid-cols-1 px-6 py-12 place-items-center
           md:grid-cols-2 md:px-12 md:py-16 md:overflow-auto
           lg:px-16 h-128"
      >
      <!-- Left -->
      <div class="md:pr-12 lg:pr-16 ">
          <p
            class="text-sm md:text-base uppercase tracking-[0.12em]
               text-(--mission-accent,deeper-teal)"
          >
            Our Mission
          </p>

          <!-- Small line -->
          <div class="mt-3 h-px w-8 bg-(--mission-accent,deeper-teal)"></div>

          <h2
            class="mt-5 max-w-md font-serif text-3xl
               leading-[1.15] text-(--mission-heading,deeper-teal)
               md:text-4xl"
          >
            Helping you move better,
            <br />
            feel better, and
            <span class="italic text-(--mission-accent,deeper-teal)"> live fully. </span>
          </h2>

          <a
            href="/about"
            class="animate-float mt-6 inline-flex items-center gap-2
               text-xs font-extrabold  uppercase tracking-widest
               text-(--mission-muted,deeper-teal)"
          >
            Meet your PT
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Right -->
        <div
          class="mt-10 border-t border-(--mission-accent,deeper-teal) pt-10
             md:mt-0 md:border-l md:border-t-0 text-sm
             md:pl-12 md:pt-0 
             lg:pl-16 "
        >
          <div
            class="max-w-lg space-y-5 text-center 
        
       leading-7 lg:leading-8
       "
          >
            <p class="text-(--color-gray-950,deeper-teal) lg:text-xl tracking-wider">
              Dark Gray-At MVMNT Matters, we bring expert physical therapy to your home,
              gym, or office—so you can get better without putting your life on
              hold.
            </p>

            <p class="lg:text-md text-slate-950">
              Slate-950-Personalized care. Proven expertise.
              <br />
              Results that move with you.
            </p>
            <p class="lg:text-xl text-(--mission-accent)">
              Matches Our Mission and Live Fully.-Personalized care. Proven expertise.
              <br />
              Results that move with you.
            </p>
            <p class="lg:text-xl text-(deeper-teal) tracking-wide font-semibold">
              Deeper-Teal Semi-bold.Personalized care. Proven expertise.
              <br />
              Results that move with you.
            </p>
            <p class="lg:text-xl text-(deeper-teal) tracking-wide ">
              Deeper-Teal.Personalized care. Proven expertise.
              <br />
              Results that move with you.
            </p>
            <p class="lg:text-xl text-(--color-amber-950,deeper-teal) tracking-wider">
              Very Dark Amber.Personalized care. Proven expertise.
              <br />
              Results that move with you.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="grid place-items-center bg-(--choose-us-bg) p-6 md:p-8  min-h-128">
      <div class="mx-auto mt-8 sm:mt-0  w-full md:max-w-7xl">
        <div class="mb-12 text-center max-w-x">
          <h2
            class=" font-semibold uppercase tracking-[0.18em] text-(--choose-us-heading,--meet-body)"
          >
            Why Choose Us
          </h2>

          <div class="mx-auto mt-3 h-px w-10 bg-deeper-teal/60"></div>
        </div>
        <div
          class:list={[
            `
          md:mx-auto w-full grid  grid-cols-1  gap-y-4
          md:grid-cols-2 md:gap-5 md:max-w-6xl
          lg:grid-cols-5 lg:gap-y-0 
          `,
          ]}
        >
          {
            features.map((feature, index) => {
              const Icon = feature.icon;
              return (
                <div
                  class:list={[
                    `
              flex flex-col items-center gap-y-4 rounded-xl bg-white/60 py-2 
              shadow-sm 

              sm:items-center sm:text-center 0 
              md:px-5 md:py-5 

              lg:rounded-none lg:bg-transparent lg:px-6 lg:py-0
              lg:shadow-none 
            `,
                    index < features.length - 1 &&
                      'lg:border-r lg:border-deeper-teal/30  ',
                  ]}
                >
                  <div class="flex size-14  flex-col items-center justify-center rounded-full border border-[#000A14] md:border-0 ">
                    <Icon
                      className="size-8 md:size-12 stroke-[#000A14] fill-[#000A14] md:fill-none"
                      strokeWidth={1.5}
                    />

                  </div>
                  <div class=" md:px-0">
                  <h3
                    class="mt-2 flex lg:h-16 max-w-48 md:px-0 items-start justify-center text-center
                     text-sm font-bold uppercase leading-6
                     tracking-[0.08em] text-(--mission-body)"
                  >
                    {feature.title}
                  </h3>
                  <div class="mx-auto mt-2 h-px w-16 bg-deeper-teal/60 lg:hidden"></div>
                  </div>

                  <p class="md:mt-2 max-w-52 text-sm leading-7 text-(--choose-us-muted,slate-700) md:block text-center">
                    {feature.description}
                  </p>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>


    <section class="[background:var(--we-treat-bg)] ">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center
           px-6 py-12
           md:grid-cols-2 md:gap-12 md:px-12 md:py-16
           lg:gap-16 lg:px-16 lg:min-h-192"
  >
    <!-- Image collage - hidden on mobile -->
    <div class="hidden md:grid grid-cols-2 gap-1.5 max-w-2xl">
      {
        images.map((image) => (
          <div class="aspect-square overflow-hidden">
            <Image
              src={image.src}
              alt={image.alt}
              widths={[400, 600, 800]}
              sizes="(max-width: 1024px) 40vw, 500px"
              class="size-full object-cover"
            />
          </div>
        ))
      }
    </div>

    <!-- Content -->
    <div class="md:pl-4 ">
      <p
        class="text-xs sm:text-sm font-bold uppercase tracking-[0.14em]
               text-(deeper-teal)"
      >
        What We Treat
      </p>

      <div class="mt-3 h-px w-8 bg-(--mission-accent,deeper-teal)"></div>

      <h2
        class="mt-5 max-w-md font-serif  text-3xl leading-[1.15]
               text-(--light-heading,deeper-teal) md:text-4xl"
      >
        From everyday pain
        <br class=" sm:block" />
        <span class="italic text-deeper-teal">to your biggest goals.</span>
      </h2>
 

      <p
        class="mt-4 max-w-md text-sm leading-relaxed
               text-(--mission-muted,deeper-teal)"
      >
        Specialized care for a wide range of conditions and activities.
      </p>

      <!-- Services -->
      <div class="mt-7 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          servicesWeTreat.map((service) => (
            <div class="flex items-center gap-2.5">
              <!-- Check icon -->
              <CircleCheck className='text-(--mission-paragraph,deeper-teal)' />

              <span class="text-sm md:text-base font-bold text-(deeper-teal)">
                {service}
              </span>
            </div>
          ))
        }
      </div>

      <p class="mt-7 text-sm text-(--mission-muted,deeper-teal)">
        Don't see your condition listed?
      </p>

      <a
        href="/contact"
        class="mt-1 inline-block text-sm font-extrabold
               text-(--mission-italic,deeper-teal) underline-offset-4
               hover:underline"
      >
        Reach out—we can help.
      </a>
    </div>
  </div>
</section>

<section class="[background:var(--me-bg)]">
  <div
    class="mx-auto grid w-full md:max-w-7xl grid-cols-1 gap-6 
           md:grid-cols-2 lg:place-items-center text-center md:gap-12 md:px-10 p-16"
  >
    <!-- Image -->
    <div class="w-full lg:max-w-xl ">

                <Image
            src={elieHeadshot}
            alt="Elie Sabins"
            widths={[600, 800, 1000]}
              sizes="(max-width: 900px) 40vw, 500px"
            class="    mx-auto
    h-auto w-64 rounded-full object-cover
    md:w-full md:rounded-xl "
          />

    </div>

    <!-- Text -->
    <div class="max-w-lg p-2">
      <p
        class="text-sm md:text-base font-semibold  uppercase tracking-[0.12em]
               text-[deeper-teal]"
      >
        Meet Elie
      </p>

      <h2
        class="mt-3 font-serif text-3xl leading-tight text-(--meet-heading,slate-900)
               md:text-4xl"
      >
        Hi, I’m Elie.
      </h2>

      <p class="mt-5 text-sm leading-7 text-(--meet-body,slate-700) md:text-base">
        I'M DEEPER TEAL.I believe great physical therapy starts with really knowing the person
        in front of you—not just their diagnosis.
      </p>

      <p class="mt-5 text-sm leading-7 text-(--mission-body) md:text-base">
        I'M A DARK STONE. I created MVMNT Matters to offer the kind of care I believe healthcare
        should be: personal, thoughtful, evidence-informed, and built around
        your real life.
      </p>
      <p class="mt-5 text-sm leading-7 md:text-base">
        I'M DEFAULT BLACK. I created MVMNT Matters to offer the kind of care I believe healthcare
        should be: personal, thoughtful, evidence-informed, and built around
        your real life.
      </p>

      <a
        href="/about"
        class="mt-7 inline-flex items-center gap-2 text-xs text-(--meet-body) font-semibold uppercase
               tracking-[0.12em] 
               hover:gap-3 animate-float"
      >
        Get to know me
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>


<section class="[background:var(--testimonial-bg)]">
  <h1 class="text-center font-serif lg:text-3xl mt-4 text-[#07131D]">Testimonials</h1>
        <TestimonialCarousel testimonials={formattedTestimonials} client:load />

      </section>

  </main>
</BaseLayout>

<style>

   #theme-preview[data-theme="default"]{
    --dark-heading:#102a33;
    --dark-body:#263D48;
    --dark-muted:#49636D;
    --dark-accent:#F5D58A;
    --light-heading:white;

    --meet-heading:white;
    --meet-body:var(--color-deeper-teal);
    
    --mission-heading:white;
    --mission-body: var(--color-stone-950);
    --mission-accent: var(--color-neutral-900) ;
    --mission-muted:#102a33 ;

--mission-bg: color-mix(
  in srgb,
  var(--color-sky-alt) 50%,
  white
);
    --choose-us-bg: color-mix(
  in srgb,
  var(--color-sand) 40%,
  white
);
  --we-treat-bg:
  color-mix(
  in srgb,
  var(--color-sky-alt) 50%,
  white
);
    --me-bg: color-mix(
  in srgb,
  var(--color-sand) 40%,
  white
);
    --testimonial-bg:color-mix(
  in srgb,
  var(--color-sky-alt) 50%,
  white
);

  }

  #theme-preview[data-theme="option-3"] {
      --mission-heading:var(--color-deep-teal);
    --mission-body: var(--color-deep-teal);
    --mission-accent: #287A8E ;

    --mission-bg: var(--color-ivory);
    --mission-text: #07131D;
    --choose-us-bg: var(--color-sand);
    --we-treat-bg: var(--color-ivory);
    --me-bg: var(--color-sand);
    --testimonial-bg:var(--color-ivory);
  }

  #theme-preview[data-theme="option-1"]{
    --mission-heading:var(--color-deeper-teal);
    --mission-body: var(--color-deeper-teal);
    --mission-accent: #287A8E ;
    --mission-muted:#287A8E ;
    --mission-text: #07131D;
    
    --choose-us-heading:#000A14;
    --choose-us-accent: var(--color-blue-800);
    --choose-us-muted: #60747C;
    
    --mission-bg: var(--color-ivory);
    --choose-us-bg: var(--color-sky);
    --we-treat-bg: var(--color-ivory);
    --me-bg: var(--color-sky);
    --testimonial-bg:var(--color-ivory);
  }
  #theme-preview[data-theme="option-2"]{
    --mission-heading:ivory;
    --mission-body: white;
    --mission-accent: #07131D ;
    --mission-muted:#07131D ;

    --choose-us-heading:#000A14;
    --choose-us-accent: var(--color-deeper-teal);
    --choose-us-muted: #60747C;

    --meet-heading:var(--color-ivory);
    --meet-accent:#07131D;
    --meet-body: white;

    --mission-bg: color-mix(
      in srgb,
      var(--color-sky-alt) 95%,
    white
);
    --mission-text: #07131D;
        --choose-us-bg: color-mix(
        in srgb,
        var(--color-sand) 55%,
      white
);
    --we-treat-bg: var(--color-white);
    --me-bg: color-mix(
      in srgb,
      var(--color-sky-alt) 95%,
    white
);;
    --testimonial-bg:var(--color-sand);
  }
 
  #theme-preview[data-theme="option-4"]{
--mission-bg: color-mix(
  in srgb,
  var(--color-deeper-teal) 95%,
  white
);
    --mission-heading:#FFF1D6;
    --mission-body: white;
    --mission-accent: var(--color-sky-alt) ;
    --mission-muted:var(--color-sky-alt) ;
    --mission-text: var(--color-ivory);
    --mission-italic:var(--color-sky-alt) ;
    --mission-paragraph:#C9D6D8 ;

    --choose-us-bg: color-mix(
  in srgb,
  var(--color-sand) 30%,
  white
);
  --we-treat-bg:
  color-mix(
  in srgb,
  var(--color-deeper-teal) 95%,
  white
);
    --me-bg: color-mix(
  in srgb,
  var(--color-sand) 30%,
  white
);
    --testimonial-bg:white;
  }

#theme-preview[data-theme="option-5"]{

    --mission-heading:ivory;
    --mission-body: ivory;
