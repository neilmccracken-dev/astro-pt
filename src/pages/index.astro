<style>
  @keyframes textReveal {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0%);
    }
  }

  /* Target both elements, hide them at start, and freeze them at the end */
  [class*='animate-[textReveal'] {
    opacity: 0; /* Keeps them invisible until animation starts */
    animation-fill-mode: forwards !important;
  }
</style>

<script>
  function setupMissionObserver() {
    const section = document.getElementById('mission-section');

    if (!section) return;

    const animatedElements = section.querySelectorAll(
      '.reveal-left, .reveal-right',
    );

    if (!animatedElements.length) return;

    const desktop = window.matchMedia('(min-width: 768px)');

    // Mobile: ensure everything is visible.
    if (!desktop.matches) {
      animatedElements.forEach((element) => {
        element.classList.add('in-view');
      });

      return;
    }

    // Reset the elements when returning to this page.
    animatedElements.forEach((element) => {
      element.classList.remove('in-view');
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;

        animatedElements.forEach((element) => {
          element.classList.add('in-view');
        });

        observer.disconnect();
      },
      {
        threshold: 0.25,
      },
    );

    observer.observe(section);
  }

  document.addEventListener('astro:page-load', setupMissionObserver);
</script>

